# Application Configuration
APP_NAME=Web App

# API Configuration
API_URL=http://localhost:3000/api

# Supabase (local defaults from `npx supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never put this in an Angular environment file.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Docker (docker-compose.yml reads this file automatically)
# ---------------------------------------------------------------------------
# Host ports. The container ports are fixed (web 4000, api 3000, admin 80).
WEB_PORT=4000
ADMIN_PORT=4300
API_PORT=3000

# Hosts the SSR server will render for. Angular rejects an unlisted Host header
# and silently falls back to client-side rendering, so add your public hostname
# before deploying. `*` disables the check.
WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# How the API container reaches Supabase. SUPABASE_URL above is the URL the
# *browser* uses; inside a container 127.0.0.1 is the container itself, so a
# Supabase stack running on the host is host.docker.internal.
SUPABASE_URL_INTERNAL=http://host.docker.internal:54321
